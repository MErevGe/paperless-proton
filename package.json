    "coverage": "node tests/browser_coverage.mjs"
  },
  "devDependencies": {
    "eslint": "10.15.0",
    "globals": "17.4.0",
    "istanbul-lib-coverage": "3.2.2",
    "prettier": "3.10.1",
    "v8-to-istanbul": "9.3.0"
  }
}
